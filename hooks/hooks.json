{
  "description": "Keeps the claudemeter status line wired into your settings while the plugin is enabled.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-enable.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
